{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["web-bluetooth", "vite/client"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
